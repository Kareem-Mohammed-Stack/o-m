{%- style -%}
  #ClickableHero-{{ section.id }} {
    margin: 0;
    padding: 0;
    position: relative;
    z-index: 1;
    isolation: isolate;
  }

  .clickable-hero__wrapper {
    position: relative;
    width: 100%;
    overflow: visible;
    z-index: 1;
    isolation: isolate;
  }

  .clickable-hero__link,
  .clickable-hero__media {
    display: block;
    line-height: 0;
    text-decoration: none;
    color: inherit;
    position: relative;
    z-index: 1;
  }

  .clickable-hero__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .clickable-hero__hotspots {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
  }

  .hero-hotspot {
    position: absolute;
    top: var(--pos-y);
    left: var(--pos-x);
    transform: translate(-50%, -50%);
    pointer-events: auto;
    z-index: 10;
  }

  @media screen and (max-width: 749px) {
    .hero-hotspot {
      top: var(--pos-y-m);
      left: var(--pos-x-m);
    }
  }

  .hero-hotspot__pin {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    border: 1.5px solid rgba(227, 48, 84, 0.3);
    color: #1C1917;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.28), 0 0 0 4px rgba(255, 255, 255, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    position: relative;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    outline: none;
  }

  .hero-hotspot__pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.7);
    animation: heroHotspotPulse 2s infinite ease-out;
    pointer-events: none;
  }

  @keyframes heroHotspotPulse {
    0% { transform: scale(1); opacity: 0.8; }
    100% { transform: scale(2.4); opacity: 0; }
  }

  .hero-hotspot:hover .hero-hotspot__pin,
  .hero-hotspot:focus-within .hero-hotspot__pin,
  .hero-hotspot.is-active .hero-hotspot__pin {
    background: #E33054;
    color: #FFFFFF;
    transform: scale(1.15);
    border-color: #E33054;
    box-shadow: 0 8px 24px rgba(227, 48, 84, 0.45);
  }

  /* Hotspot Preview Card */
  .hero-hotspot__card {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    width: max-content;
    min-width: 210px;
    max-width: 270px;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-radius: 12px;
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.24);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    pointer-events: none;
    display: flex;
    gap: 10px;
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.9);
    text-decoration: none;
    z-index: 25;
  }

  .hero-hotspot:hover .hero-hotspot__card,
  .hero-hotspot:focus-within .hero-hotspot__card,
  .hero-hotspot.is-active .hero-hotspot__card {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }

  .hero-hotspot__card:hover {
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.3);
    transform: translateX(-50%) translateY(-2px);
  }

  .hero-hotspot__card-img {
    width: 46px;
    height: 46px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
    background: #FAF6F5;
    border: 1px solid #F0E6E8;
  }

  .hero-hotspot__card-content {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    flex-grow: 1;
    text-align: left;
    line-height: 1.2;
  }

  .hero-hotspot__card-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #1C1917;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 3px;
  }

  .hero-hotspot__card-price {
    font-size: 1.45rem;
    font-weight: 800;
    color: #E33054;
    margin-bottom: 4px;
  }

  .hero-hotspot__card-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 1.15rem;
    font-weight: 700;
    color: #57534E;
    transition: color 0.2s ease;
  }

  .hero-hotspot__card:hover .hero-hotspot__card-cta {
    color: #E33054;
  }

  .hero-hotspot__card-cta svg {
    transition: transform 0.2s ease;
  }

  .hero-hotspot__card:hover .hero-hotspot__card-cta svg {
    transform: translateX(3px);
  }
{%- endstyle -%}

{%- liquid
  assign hero_link = section.settings.link
  if hero_link == blank
    assign hero_link = routes.all_products_collection_url
  endif

  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif

  assign hero_alt = section.settings.alt_text | default: shop.name

  assign has_custom_images = false
  if section.settings.image_desktop != blank or section.settings.image_tablet != blank or section.settings.image_mobile != blank or section.settings.image != blank
    assign has_custom_images = true
  endif
-%}

<section id="ClickableHero-{{ section.id }}" class="clickable-hero">
  <div class="clickable-hero__wrapper">
    <a class="clickable-hero__link" href="{{ hero_link }}" aria-label="{{ hero_alt | escape }}">
      {%- if has_custom_images -%}
        {%- liquid
          assign img_desktop = section.settings.image_desktop | default: section.settings.image
          assign img_tablet = section.settings.image_tablet | default: img_desktop
          assign img_mobile = section.settings.image_mobile | default: img_tablet
          if img_mobile != blank and img_mobile.alt != blank
            assign hero_alt = img_mobile.alt
          endif
        -%}
        <picture>
          {%- if img_desktop != blank -%}
            <source
              media="(min-width: 1200px)"
              srcset="{{ img_desktop | image_url: width: 2400 }} 2400w, {{ img_desktop | image_url: width: 1800 }} 1800w"
              sizes="100vw"
            >
          {%- endif -%}
          {%- if img_tablet != blank -%}
            <source
              media="(min-width: 750px)"
              srcset="{{ img_tablet | image_url: width: 1600 }} 1600w, {{ img_tablet | image_url: width: 1200 }} 1200w"
              sizes="100vw"
            >
          {%- endif -%}
          {%- if img_mobile != blank -%}
            {{
              img_mobile
              | image_url: width: 1200
              | image_tag:
                class: 'clickable-hero__image',
                widths: '400, 600, 800, 1000, 1200',
                sizes: '100vw',
                alt: hero_alt,
                loading: 'eager',
                fetchpriority: fetch_priority
            }}
          {%- elsif img_tablet != blank -%}
            {{
              img_tablet
              | image_url: width: 1600
              | image_tag:
                class: 'clickable-hero__image',
                widths: '750, 1100, 1500, 1600',
                sizes: '100vw',
                alt: hero_alt,
                loading: 'eager',
                fetchpriority: fetch_priority
            }}
          {%- else -%}
            {{
              img_desktop
              | image_url: width: 2400
              | image_tag:
                class: 'clickable-hero__image',
                widths: '750, 1100, 1500, 1780, 2000, 2400',
                sizes: '100vw',
                alt: hero_alt,
                loading: 'eager',
                fetchpriority: fetch_priority
            }}
          {%- endif -%}
        </picture>
      {%- else -%}
        <picture>
          <source
            media="(min-width: 750px)"
            srcset="{{ 'bunner.png' | asset_url }}"
          >
          <img
            class="clickable-hero__image"
            src="{{ 'hero-banner-responsive.png' | asset_url }}"
            alt="{{ hero_alt | escape }}"
            width="444"
            height="585"
            loading="eager"
            fetchpriority="{{ fetch_priority }}"
          >
        </picture>
      {%- endif -%}
    </a>

    {%- if section.blocks.size > 0 -%}
      <div class="clickable-hero__hotspots" aria-label="Shoppable Hero Products">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'hotspot' -%}
              {%- liquid
                assign hotspot_prod = block.settings.product
                if hotspot_prod != blank
                  assign target_url = hotspot_prod.url
                  assign target_title = hotspot_prod.title
                  assign target_price = hotspot_prod.price | money
                  if hotspot_prod.featured_media
                    assign target_img = hotspot_prod.featured_media | image_url: width: 120
                  elsif block.settings.fallback_image != blank
                    assign target_img = block.settings.fallback_image | image_url: width: 120
                  elsif block.settings.fallback_image_asset != blank
                    assign target_img = block.settings.fallback_image_asset | asset_url
                  else
                    assign target_img = ''
                  endif
                else
                  assign target_url = block.settings.url | default: routes.all_products_collection_url
                  assign target_title = block.settings.title | default: 'Featured Product'
                  assign target_price = block.settings.price | default: '$49.00'
                  if block.settings.fallback_image != blank
                    assign target_img = block.settings.fallback_image | image_url: width: 120
                  elsif block.settings.fallback_image_asset != blank
                    assign target_img = block.settings.fallback_image_asset | asset_url
                  else
                    assign target_img = ''
                  endif
                endif

                assign pos_x = block.settings.pos_x | default: 50
                assign pos_y = block.settings.pos_y | default: 50
                assign pos_x_mobile = block.settings.pos_x_mobile | default: pos_x
                assign pos_y_mobile = block.settings.pos_y_mobile | default: pos_y
              -%}

              <div
                class="hero-hotspot"
                id="HeroHotspot-{{ block.id }}"
                style="--pos-x: {{ pos_x }}%; --pos-y: {{ pos_y }}%; --pos-x-m: {{ pos_x_mobile }}%; --pos-y-m: {{ pos_y_mobile }}%;"
                {{ block.shopify_attributes }}
              >
                <a
                  href="{{ target_url }}"
                  class="hero-hotspot__pin"
                  aria-label="View {{ target_title | escape }}"
                  title="View {{ target_title | escape }}"
                >
                  <span class="hero-hotspot__pulse"></span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </a>

                <a
                  href="{{ target_url }}"
                  class="hero-hotspot__card"
                  aria-label="View product details for {{ target_title | escape }}"
                >
                  {%- if target_img != blank -%}
                    <img
                      src="{{ target_img }}"
                      alt="{{ target_title | escape }}"
                      class="hero-hotspot__card-img"
                      width="46"
                      height="46"
                      loading="lazy"
                    >
                  {%- endif -%}
                  <div class="hero-hotspot__card-content">
                    <div class="hero-hotspot__card-title">{{ target_title }}</div>
                    <div class="hero-hotspot__card-price">{{ target_price }}</div>
                    <div class="hero-hotspot__card-cta">
                      <span>View Product</span>
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                      </svg>
                    </div>
                  </div>
                </a>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function() {
    function initHeroHotspots() {
      var heroSection = document.getElementById('ClickableHero-{{ section.id }}');
      if (!heroSection) return;

      var hotspots = heroSection.querySelectorAll('.hero-hotspot');
      hotspots.forEach(function(hotspot) {
        var pin = hotspot.querySelector('.hero-hotspot__pin');
        if (!pin) return;

        pin.addEventListener('click', function(e) {
          if (window.matchMedia('(hover: none)').matches) {
            if (!hotspot.classList.contains('is-active')) {
              e.preventDefault();
              hotspots.forEach(function(h) { h.classList.remove('is-active'); });
              hotspot.classList.add('is-active');
            }
          }
        });
      });

      document.addEventListener('click', function(e) {
        if (!e.target.closest('.hero-hotspot')) {
          hotspots.forEach(function(h) { h.classList.remove('is-active'); });
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroHotspots);
    } else {
      initHeroHotspots();
    }
  })();
</script>

{% schema %}
{
  "name": "Clickable hero",
  "tag": "section",
  "class": "section-clickable-hero",
  "settings": [
    {
      "type": "paragraph",
      "content": "Upload campaign images below. Desktop and tablet share the desktop image; mobile uses the mobile image."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Shown below 750px. Portrait 3:4 works best."
    },
    {
      "type": "image_picker",
      "id": "image_tablet",
      "label": "Tablet image",
      "info": "Shown from 750px to 1199px. 4:3 works best."
