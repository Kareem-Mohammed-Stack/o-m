{%- liquid
  assign hero_link = routes.all_products_collection_url
  if section.settings.collection != blank
    assign hero_link = section.settings.collection.url
  endif
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0
  assign hero_alt = section.settings.heading | default: 'O&M Premium T-shirts'
  assign has_editor_image = false
  if section.settings.image_desktop != blank or section.settings.image_mobile != blank
    assign has_editor_image = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .om-hero {
    --om-hero-overlay: {{ overlay }};
    --om-hero-heading: {{ section.settings.heading_color }};
    --om-hero-cta: {{ section.settings.cta_color }};
  }
{%- endstyle -%}

<section
  id="OmHero-{{ section.id }}"
  class="om-hero{% unless has_editor_image %} om-hero--asset{% endunless %}{% if section.settings.make_clickable %} om-hero--clickable{% endif %}"
  aria-labelledby="OmHeroHeading-{{ section.id }}"
>
  <a
    class="om-hero__link"
    href="{{ hero_link }}"
    aria-label="{{ section.settings.cta_label | default: 'Shop all products' | escape }}"
  >
    <div class="om-hero__media">
      {%- if has_editor_image -%}
        {%- if section.settings.image_desktop != blank -%}
          {{
            section.settings.image_desktop
            | image_url: width: 2400
            | image_tag:
              class: 'om-hero__image om-hero__image--desktop',
              widths: '750, 1100, 1500, 1780, 2000, 2400',
              sizes: '100vw',
              preload: true,
              fetchpriority: 'high',
              loading: 'eager',
              alt: section.settings.image_desktop.alt | default: hero_alt | escape
          }}
        {%- endif -%}
        {%- if section.settings.image_mobile != blank -%}
          {{
            section.settings.image_mobile
            | image_url: width: 1200
            | image_tag:
              class: 'om-hero__image om-hero__image--mobile',
              widths: '375, 550, 750, 1100, 1200',
              sizes: '100vw',
              preload: true,
              fetchpriority: 'high',
              loading: 'eager',
              alt: section.settings.image_mobile.alt | default: hero_alt | escape
          }}
        {%- endif -%}
      {%- else -%}
        <picture>
          <source
            media="(min-width: 750px)"
            srcset="{{ 'bunner.png' | asset_url }} 1942w"
            width="1942"
            height="809"
          >
          <img
            class="om-hero__image om-hero__image--mobile"
            src="{{ 'hero-banner-responsive.png' | asset_url }}"
            alt="{{ hero_alt | escape }}"
            width="444"
            height="585"
            fetchpriority="high"
            loading="eager"
          >
        </picture>
      {%- endif -%}
    </div>
  </a>

  {%- if has_editor_image -%}
    <div class="om-hero__overlay" aria-hidden="true"></div>

    <div class="om-hero__content page-width">
      {%- if section.settings.heading != blank -%}
        <h1 id="OmHeroHeading-{{ section.id }}" class="om-hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- else -%}
        <h1 id="OmHeroHeading-{{ section.id }}" class="visually-hidden">{{ hero_alt | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="om-hero__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <span class="om-hero__cta">{{ section.settings.cta_label | escape }}</span>
      {%- endif -%}
    </div>
  {%- else -%}
    <h1 id="OmHeroHeading-{{ section.id }}" class="visually-hidden">{{ hero_alt | escape }}</h1>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Editorial hero",
  "tag": "section",
  "class": "section om-hero-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Desktop uses assets/bunner.png. Mobile uses assets/hero-banner-responsive.png. The whole banner links to all products."
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 0
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Premium T-shirts"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Iconic style. Everyday wear."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link label",
      "default": "Shop all products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Link collection",
      "info": "Leave blank to send shoppers to all products."
    },
    {
      "type": "checkbox",
      "id": "make_clickable",
      "label": "Make entire hero clickable",
      "default": true
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "cta_color",
      "label": "Button color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Editorial hero"
    }
  ]
}
{% endschema %}
