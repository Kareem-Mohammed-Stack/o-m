{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection = section.settings.collection
  if collection == blank
    assign collection = collections.all
  endif
  assign product_limit = section.settings.products_to_show | default: 8
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .om-grid {
    padding-top: {{ section.settings.padding_top | times: 0.65 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.65 | round }}px;
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .om-grid {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  #shopify-section-{{ section.id }} .om-grid__heading {
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .om-grid__view-all {
    color: {{ section.settings.accent_color }};
  }
{%- endstyle -%}

<section class="om-grid" aria-labelledby="OmGridHeading-{{ section.id }}">
  <div class="page-width">
    <div class="om-grid__header">
      {%- if section.settings.title != blank -%}
        <h2 id="OmGridHeading-{{ section.id }}" class="om-grid__heading">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.show_view_all -%}
        <a class="om-grid__view-all" href="{{ collection.url | default: routes.all_products_collection_url }}">
          {{ section.settings.view_all_label | escape }}
        </a>
      {%- endif -%}
    </div>

    <ul class="om-grid__list" role="list">
      {%- if collection.products.size > 0 -%}
        {%- for product in collection.products limit: product_limit -%}
          <li class="om-grid__item">
            {% render 'product-card-custom',
              card_product: product,
              media_aspect_ratio: section.settings.image_ratio,
              show_secondary_image: section.settings.show_secondary_image,
              show_quick_add: section.settings.enable_quick_add,
              section_id: section.id,
              lazy_load: true
            %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li class="om-grid__item">
            {% render 'product-card-custom',
              placeholder_image: 'product-apparel-1',
              section_id: section.id
            %}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Featured product grid",
  "tag": "section",
  "class": "section om-featured-grid-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "New arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "adapt", "label": "Adapt" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "label": "Enable quick add",
      "default": true
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f4f4f2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "View all color",
      "default": "#C69545"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Featured product grid"
    }
  ]
}
{% endschema %}
