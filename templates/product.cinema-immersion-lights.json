EH"],"name":"t:sections.rich-text.presets.name","settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"background-2","full_width":true,"padding_top":12,"padding_bottom":12}},"wave_Y8ndwU":{"type":"wave","disabled":true,"name":"Wave","settings":{"wave_height":300,"wave_curvature":250,"wave_style":"less","wave_side":"180","animation":true,"animation_duration":5,"background_color":"#ffffff","wave_color":"#000000","margin_top":0,"margin_bottom":-100,"padding_top":0,"padding_bottom":0,"padding_horizontal":0,"padding_horizontal_mobile":0,"full_width":true,"content_width":120}},"lumin_review_8EHAak":{"type":"Lumin-review","blocks":{"review_atbEdY":{"type":"review","settings":{"star_rating":5,"name_text":"John D.","date_text":"January 2025","review_head":"","review_text":"\"The TV Sync Backlight completely transformed my movie nights! The lighting syncs perfectly with what’s on the screen, making everything feel more immersive. Highly recommend!\"","like_size":56,"dislike_size":0,"feature_font_size":16}},"review_69rGQa":{"type":"review","settings":{"star_rating":5,"name_text":"Gary P.","date_text":"January 2025","review_head":"","review_text":"\"Great product! Easy to install, and the app control is a nice touch. The colors are vibrant and perfect for gaming, but I wish it had a bit more customization for brightness.\"","like_size":37,"dislike_size":0,"feature_font_size":16}},"review_mmwK9n":{"type":"review","settings":{"star_rating":5,"name_text":"Nick F.","date_text":"February 2025","review_head":"","review_text":"\"I love how the TV Backlight adds an extra level of excitement to my TV time. It makes watching movies feel like a cinema experience right at home!\"","like_size":26,"dislike_size":0,"feature_font_size":16}},"review_Q4wjiT":{"type":"review","settings":{"star_rating":5,"name_text":"Shirley H.","date_text":"March 2025","review_head":"","review_text":"\"This product works exactly as advertised. Installation was a breeze, and the lighting effects are fantastic. It would be awesome if there were more preset themes for different types of content.\"","like_size":81,"dislike_size":0,"feature_font_size":16}},"review_L9RJxn":{"type":"review","settings":{"star_rating":5,"name_text":"Aaron L.","date_text":"April 2025","review_head":"","review_text":"\"Amazing addition to my TV setup! The backlight is so easy to set up and works flawlessly. Perfect for both gaming and watching shows. A must-have!\"","like_size":22,"dislike_size":0,"feature_font_size":16}}},"block_order":["review_atbEdY","review_69rGQa","review_mmwK9n","review_Q4wjiT","review_L9RJxn"],"name":"Lumin Review","settings":{"editing":true,"color_scheme":"","header_text":"what our customers say about us","show_top":true,"rating_text":"4.8","rating_range":4.5,"rating_count":"","review_column_mobile":"1","review_column_tab":"1","review_column_desk":"1","review_load":"4","load_text":"Load More","rw_img_size":140,"rw_img_radius":0,"block_name_size":20,"date_size":16,"block_head_size":20,"block_text_size":14,"star_style":"star_bg","star_size":1,"feature_svg_color":"#dff80b","inactive_star_color":"#e2e2e2","show_border":true,"rw_border":"#f2f2f2","border_radius":0,"section_bg3":"#000000","section_bg2":"#1154f6","verify_text":"Verified Buyer","review_bg":"#ffffff","feature_acc_color":"#000000","review_pd":20,"review_pd_m":20,"show_footer":true,"show_product":true,"like_text":"Was this helpful?","rw_margin":0,"padding_top":36,"padding_bottom":36}},"collapsible_content_3UiDhf":{"type":"collapsible-content","blocks":{"collapsible_row_U8zDz7":{"type":"collapsible_row","settings":{"heading":"Does it really sync in real-time?","icon":"none","row_content":"<p>Yes! The camera continuously reads your screen and adjusts the lighting in real-time to match what’s on your display. Whether you're watching movies, gaming, or listening to music, the lighting adapts instantly to enhance the immersion and create a dynamic environment.<\/p>","page":""}},"collapsible_row_QNi4hr":{"type":"collapsible_row","settings":{"heading":"Can I still use it without damaging my wall or TV?","icon":"none","row_content":"<p>Absolutely! The LED backlight uses a strong removable adhesive that won’t leave any marks or residue on your walls or TV. It's perfect for renters or anyone who wants flexibility.<\/p>","page":""}},"collapsible_row_4b3NeT":{"type":"collapsible_row","settings":{"heading":"Collapsible rowIs it hard to install?","icon":"none","row_content":"<p>Not at all! Installation is quick and easy - most users set it up in under 15 minutes. Our app will guide you through each step, from mounting the lights to syncing them with your TV. No technical expertise is required, just plug it in and go!<\/p>","page":""}},"collapsible_row_GVMWKA":{"type":"collapsible_row","settings":{"heading":"What if I don’t like how the camera looks?","icon":"none","row_content":"<p>The camera is designed to be minimal and sleek, but if you prefer a less visible look, it can be mounted discreetly to blend into your setup. You can place it in a way that keeps it out of sight while still providing accurate color syncing.<\/p>","page":""}},"collapsible_row_jrHLGw":{"type":"collapsible_row","settings":{"heading":"How do I control it?","icon":"none","row_content":"<p>You control everything through our free mobile app. The app lets you easily switch between modes (like Movie, Gaming, Music), adjust brightness, and customize your lighting. It’s all right at your fingertips.<\/p>","page":""}},"collapsible_row_YwhPpB":{"type":"collapsible_row","settings":{"heading":"Is it worth it compared to cheaper LED strips?","icon":"none","row_content":"<p>Absolutely! Cheaper LED strips don’t offer the real-time syncing, customization, or immersive lighting that our product does. Many of them also have adhesive issues or lack modes for different activities. Our TV Backlight kit is built for quality and delivers a superior experience every time.<\/p>","page":""}},"collapsible_row_cbxYV9":{"type":"collapsible_row","settings":{"heading":"What if I change my mind?","icon":"none","row_content":"<p>We’ve got you covered with our 30-Day Cinematic Guarantee. If you’re not completely satisfied, return it within 90 days for a full refund - no questions asked. You can shop with peace of mind knowing we stand behind our product<\/p>","page":""}}},"block_order":["collapsible_row_U8zDz7","collapsible_row_QNi4hr","collapsible_row_4b3NeT","collapsible_row_GVMWKA","collapsible_row_jrHLGw","collapsible_row_YwhPpB","collapsible_row_cbxYV9"],"name":"t:sections.collapsible_content.presets.name","settings":{"caption":"","heading":"Frequently Asked Questions","heading_size":"h1","heading_alignment":"center","layout":"none","color_scheme":"","container_color_scheme":"","open_first_collapsible_row":false,"image_ratio":"adapt","desktop_layout":"image_second","padding_top":36,"padding_bottom":36}},"related-products":{"type":"related-products","settings":{"heading":"You may also like","heading_size":"h2","collection_text_alignment":"left","products_to_show":4,"columns_desktop":4,"color_scheme":"background-1","image_ratio":"adapt","image_no_crop":true,"show_secondary_image":true,"show_vendor":false,"show_rating":false,"enable_quick_desc":true,"quick_desc_legth":90,"quick_desc_size":13,"columns_mobile":"2","padding_top":36,"padding_bottom":28}},"1755084724d90f8696":{"type":"apps","disabled":true,"settings":{"include_margins":true}}},"order":["main","ebd38537-357b-4b9d-94d3-8480c1f8694b","41eff030-bfe6-4439-9af3-bc24e7cb0559","multicolumn_ax9CUA","rich_text_XbNBGQ","image_with_text_KnRfUR","image_with_text_j7zxWc","image_with_text_K7DkyP","wave_dQ7Wn3","multicolumn_PcXJGF","wave_dH4Jqc","lumin_hero_kHYr3z","wave_wAhfjT","rich_text_Y3DJqM","wave_Y8ndwU","lumin_review_8EHAak","collapsible_content_3UiDhf","related-products","1755084724d90f8696"]}