"","link":""}}},"block_order":["column_EjHHAp","column_gNm7wc","column_hkqANj"],"name":"t:sections.multicolumn.presets.name","settings":{"title":"Here's what customers had to say!","heading_size":"h1","heading_center":"center","image_width":"full","image_ratio":"square","columns_desktop":3,"column_alignment":"center","background_style":"primary","button_label":"","button_link":"","color_scheme":"","columns_mobile":"1","swipe_on_mobile":false,"navigation_on_mobile":false,"padding_top":36,"padding_bottom":36}},"comparison_table_nYHpM9":{"type":"comparison-table","blocks":{"row_QfYmBH":{"type":"row","settings":{"benefit":"Clear Sound","us":true,"others":false}},"row_bp979A":{"type":"row","settings":{"benefit":"Rechargeable","us":true,"others":false}},"row_AULHhh":{"type":"row","settings":{"benefit":"Battery Life","us":true,"others":false}},"row_y4CenR":{"type":"row","settings":{"benefit":"Easy To Use","us":true,"others":false}}},"block_order":["row_QfYmBH","row_bp979A","row_AULHhh","row_y4CenR"],"name":"Comparison table","settings":{"title":"What Makes TruHear™ Special","heading_size":"h1","text":"<p>Find out why you should choose TruHear™ instead of other Hearing aids brands<\/p>","button_label":"","link":"","button_style_secondary":false,"layout":"table_second","color_scheme":"","logo_width":90,"mobile_logo_width":60,"us_label":"TruHear™","others_label":"Others","benefit_color_scheme":"","checkmark_color":"#53af01","icon_cells_color_scheme":"","table_corner_radius":0,"table_shadow_opacity":15,"table_shadow_horizontal_offset":0,"table_shadow_vertical_offset":0,"table_shadow_blur":0,"table_border_thickness":1,"padding_top":36,"padding_bottom":36}},"multicolumn_4HGj8t":{"type":"multicolumn","blocks":{"column_xBtKC4":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/Gemini_Generated_Image_8cvh3d8cvh3d8cvh.webp","title":"","text":"<p>Test out our rechargeable Hearing Aids for 60 days. If you're not happy with the crystal clear sound, comfortable fit, adjustable volume modes, and 48 Hours battery life, just let us know. We'll give you every penny back, no questions asked!<br\/><br\/> On top of that, we include a 1 year warranty free of charge. In the off chance your aids get damaged from drops, spills, or whatnot, we've got you covered. Just <strong>contact our helpful support team.<\/strong> Give <strong>TruHear™ Hearing Aids <\/strong>a try without any worries.<\/p>","link_label":"","link":""}}},"block_order":["column_xBtKC4"],"name":"t:sections.multicolumn.presets.name","settings":{"title":"","heading_size":"h1","heading_center":"center","image_width":"forth","image_ratio":"adapt","columns_desktop":1,"column_alignment":"center","background_style":"primary","button_label":"","button_link":"","color_scheme":"","columns_mobile":"1","swipe_on_mobile":false,"navigation_on_mobile":false,"padding_top":0,"padding_bottom":36}},"image_with_text_KnRfUR":{"type":"image-with-text","blocks":{"heading_8Ugf4E":{"type":"heading","settings":{"heading":"Fully Rechargeable - 48 Hours Battery Life","heading_size":"h1"}},"text_K6mrJp":{"type":"text","settings":{"text":"<p>Our hearing aids are FULLY rechargeable so you'll never struggle with battery changes again. Just a 4 hour overnight charge provides 48 hours of continuous, crisp clear sound. Never buy batteries again. Convenient charging gives you 2 full days of unmatched sound quality on one quick overnight charge.<\/p>","text_style":"body"}},"button_pp3qRw":{"type":"button","settings":{"button_label":"SHOP NOW","button_link":"shopify:\/\/products\/truhear™-invisible-behind-the-ears-hearing-aids","button_style_secondary":false}}},"block_order":["heading_8Ugf4E","text_K6mrJp","button_pp3qRw"],"name":"t:sections.image-with-text.presets.name","settings":{"image":"shopify:\/\/shop_images\/I1_683f0906-c123-42fa-8d34-c5c9bda419eb.webp","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"middle","desktop_content_alignment":"center","content_layou