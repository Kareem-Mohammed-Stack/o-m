op":36,"padding_bottom":36}},"image_with_text_gbR4zy":{"type":"image-with-text","blocks":{"heading_piiMj7":{"type":"heading","settings":{"heading":"What's In The Box","heading_size":"h1"}},"text_NLfdQ9":{"type":"text","settings":{"text":"<p>•A complete and in-depth user manual that covers all you need to know about your new hearing aids, including correct setup and care, achieving a perfect in-ear fit, modifying the hearing support to your particular needs, and much more!<br\/><br\/>• 4 different sizes of ultra-soft ear domes for a comfortable & discreet in-ear fit.<br\/><br\/>• 2 charging cables.<\/p>","text_style":"body"}},"button_QGpWyi":{"type":"button","settings":{"button_label":"Shop Now","button_link":"shopify:\/\/products\/truhear™-invisible-behind-the-ears-hearing-aids","button_style_secondary":false}}},"block_order":["heading_piiMj7","text_NLfdQ9","button_QGpWyi"],"name":"t:sections.image-with-text.presets.name","settings":{"image":"shopify:\/\/shop_images\/I8.webp","height":"adapt","desktop_image_width":"medium","layout":"text_first","desktop_content_position":"middle","desktop_content_alignment":"center","content_layout":"no-overlap","section_color_scheme":"","color_scheme":"","image_behavior":"none","mobile_content_alignment":"center","padding_top":36,"padding_bottom":36}},"lumin_review_8EHAak":{"type":"Lumin-review","blocks":{"review_x7iYK9":{"type":"review","settings":{"star_rating":5,"name_text":"Alex M. – London, UK","date_text":"","review_head":"A Life‑Changer!","review_text":"“I’ve struggled with mild hearing loss for years, and these hearing aids made a noticeable difference right away. The sound is clear, background noise is reduced, and they’re incredibly comfortable. The rechargeable battery lasts all day—no fiddling with tiny batteries anymore. Worth every penny!”","like_size":52,"dislike_size":0,"feature_font_size":16}},"review_LBgTkj":{"type":"review","settings":{"star_rating":5,"name_text":"Maria S. – Toronto, Canada","date_text":"","review_head":"Really Impressive for the Price","review_text":"“These work way better than I expected, especially at this price point. Easy to set up, comfortable to wear, and I can finally hear conversations in noisy environments. Only reason I gave 4 stars is that they took a bit of time to get used to.”","like_size":70,"dislike_size":0,"feature_font_size":16}},"review_NXeLe3":{"type":"review","settings":{"star_rating":5,"name_text":"Daniel T. – Berlin, Germany","date_text":"","review_head":"Good Comfort & Sound Quality","review_text":"“I’m pleasantly surprised by the audio quality. Voices sound more natural, and these are much easier to put on than my old pair. The fit could be slightly more secure for very active days, but overall very happy!”","like_size":60,"dislike_size":0,"feature_font_size":16}},"review_MJg7DX":{"type":"review","settings":{"star_rating":5,"name_text":"Priya K. – New York, USA","date_text":"","review_head":"Decent, But Not Perfect","review_text":"“The hearing aids do help, but I noticed occasional feedback in crowded spaces. They’re comfortable and recharge easily, but performance changes depending on the environment. Still a good option if you want affordable everyday use.”","like_size":42,"dislike_size":0,"feature_font_size":16}},"review_atbEdY":{"type":"review","settings":{"star_rating":5,"name_text":"Jessica L. – Sydney, Australia","date_text":"","review_head":"Exceeded Expectations!","review_text":"“I bought these for my dad, and the improvement has been amazing. He can follow conversations again without straining. Setup was simple, and the battery life lasts far longer than expected. Highly recommend!”","like_size":62,"dislike_size":0,"feature_font_size":16}},"review_69rGQa":{"type":"review","settings":{"star_rating":5,"name_text":"Omar R. – Dublin, Ireland","date_text":"","review_head":"Mixed Experience","review_text":"“They do amplify sound, but I struggled with fit and feedback at times. Might work better for mild hearing issues, but not ideal for more serious hearing loss. Customer service was helpful though!”","like_size":50,"dislike_size":0,"feature_font_size":16}},"review_mmwK9n":{"type":"review","settings":{"star_rating":5,"name_text":"Samuel W. – Madrid, Spain","date_text":"","review_head":"Finally Hearing Clearly Again!","review_text":"“I was skeptical at first, but these hearing aids truly made a difference. Sounds are crisp and natural, and I don’t struggle with conversations like before. The rechargeable feature is so convenient—no more buying tiny batteries. Highly recommend!”","like_size":44,"dislike_size":0,"feature_font_size":16}},"review_Q4wjiT":{"type":"review","settings":{"star_rating":5,"name_text":"Leila D. – Manchester, UK","date_text":"","review_head":"Comfortable & Effective","review_text":"“I love how lightweight they are—they’re comfortable even after hours of wear. They’ve helped me hear better in both quiet and moderately noisy places. Would be perfect if noise filtering was slightly stronger, but overall very satisfied.”","like_size":39,"dislike_size":0,"feature_font_size":16}},"review_L9RJxn":{"type":"review","settings":{"star_rating":5,"name_text":"Hiroshi K. – Los Angeles, USA","date_text":"","review_head":"Amazing Everyday Hearing Aid!","review_text":"“These hearing aids exceeded my expectations! They are comfortable to wear all day, easy to recharge, and really help cut down on background noise. I can finally follow conversations without constantly asking people to repeat themselves. Great value for the price!”","like_size":35,"dislike_size":0,"feature_font_size":16}}},"block_order":["review_x7iYK9","review_LBgTkj","review_NXeLe3","review_MJg7DX","review_atbEdY","review_69rGQa","review_mmwK9n","review_Q4wjiT","review_L9RJxn"],"name":"Lumin Review","settings":{"editing":true,"color_scheme":"","header_text":"what our customers say about us","show_top":true,"rating_text":"4.8","rating_range":4.5,"rating_count":"","review_column_mobile":"1","review_column_tab":"1","review_column_desk":"1","review_load":"4","load_text":"Load More","rw_img_size":140,"rw_img_radius":0,"block_name_size":20,"date_size":16,"block_head_size":20,"block_text_size":14,"star_style":"star_bg","star_size":1,"feature_svg_color":"#dff80b","inactive_star_color":"#e2e2e2","show_border":true,"rw_border":"#f2f2f2","border_radius":0,"section_bg3":"#000000","section_bg2":"#1154f6","verify_text":"Verified Buyer","review_bg":"#ffffff","feature_acc_color":"#000000","review_pd":20,"review_pd_m":20,"show_footer":true,"show_product":true,"like_text":"Was this helpful?","rw_margin":0,"padding_top":36,"padding_bottom":36}},"collapsible_content_3UiDhf":{"type":"collapsible-content","blocks":{"collapsible_row_QNi4hr":{"type":"collapsible_row","settings":{"heading":"How are these hearing aids so affordable? Is there a catch?","icon":"none","row_content":"<p>Hearing aid technology doesn't actually cost as much as the big brands charge. The expensive name-brand aids cost only a couple hundred dollars to make, yet are marked up exponentially.<br\/><br\/>We believe hearing assistance should be accessible and affordable for all. By selling directly to customers and using premium components available at reasonable prices, we're able to offer significant savings compared to other brands.<br\/><br\/>Our priority is helping people hear better, not maximizing profits. While we may not make as much per sale, making a positive impact matters more. With no hidden fees or gotchas, our affordable pricing means no barriers between you and better hearing.<\/p>","page":""}},"collapsible_row_4b3NeT":{"type":"collapsible_row","settings":{"heading":"Will the hearing aids fall out of my ear?","icon":"none","row_content":"<p>No, the hearing aids fit snugly in your ear and stay in place comfortably all day.<\/p>","page":""}},"collapsible_row_GVMWKA":{"type":"collapsible_row","settings":{"heading":"Will these hearing aids help with my tinnitus?","icon":"none","row_content":"<p>Yes, hearing aids can provide relief from tinnitus by amplifying ambient sounds. This helps mask the ringing sound. The extra sound stimulation makes the tinnitus less noticeable.<\/p>","page":""}},"collapsible_row_jrHLGw":{"type":"collapsible_row","settings":{"heading":"Why should I buy today?","icon":"none","row_content":"<p>Don't put off better hearing. Research shows prolonged untreated hearing loss raises your risk of cognitive decline.<br\/><br\/>Our comfortable, discreet aids restore conversations and social connections before hearing damage worsens.<br\/><br\/>And for a limited time, our hearing aids are 80% off - just $99.98 instead of $515.00! Don't miss huge savings to hear clearly again right away.<br\/><br\/>Act now for your health and relationships. Our sale price makes upgrading your hearing easier than eve<\/p>","page":""}},"collapsible_row_YwhPpB":{"type":"collapsible_row","settings":{"heading":"Do i need a hearing test?","icon":"none","row_content":"<p><strong>No prescription or hearing test? No problem!<\/strong><\/p><p>Our hearing aids are designed for easy self-adjustment, allowing you to enhance your hearing up to 80 dB as needed. If you’re unsure about the level of support you require, simply begin with the minimal setting and slowly increase it until your hearing feels natural again.<br\/><br\/>Adjusting the device is straightforward and quick, taking just 30 seconds with the included dial and adjustment tool. Plus, if your adjustment tool is ever lost or damaged, we’ll replace it at no cost to you.<\/p>","page":""}},"collapsible_row_cbxYV9":{"type":"collapsible_row","settings":{"heading":"Do you offer a warranty or money-back guarantee?","icon":"none","row_content":"<p>Yes, we offer both:<br\/><br\/><strong>60-Day Money-Back Guarantee<\/strong>: Fully refund your purchase within 60 days if not 100% satisfied.<br\/><br\/><strong>1 Year Warranty:<\/strong>Covers all damage including drops, water damage, etc. Full replacements provided.<br\/><br\/>Try risk-free for 60 days. If the hearing aids aren't the perfect fit for any reason, return for a full refund. Plus enjoy peace of mind with 1 year warranty coverage for damage.<\/p>","page":""}}},"block_order":["collapsible_row_QNi4hr","collapsible_row_4b3NeT","collapsible_row_GVMWKA","collapsible_row_jrHLGw","collapsible_row_YwhPpB","collapsible_row_cbxYV9"],"name":"t:sections.collapsible_content.presets.name","settings":{"caption":"","heading":"Frequently Asked Questions","heading_size":"h1","heading_alignment":"center","layout":"none","color_scheme":"","container_color_scheme":"","open_first_collapsible_row":false,"image_ratio":"adapt","desktop_layout":"image_second","padding_top":36,"padding_bottom":36}},"related-products":{"type":"related-products","settings":{"heading":"You may also like","heading_size":"h2","collection_text_alignment":"left","products_to_show":4,"columns_desktop":4,"color_scheme":"background-1","image_ratio":"adapt","image_no_crop":true,"show_secondary_image":true,"show_vendor":false,"show_rating":false,"enable_quick_desc":true,"quick_desc_legth":90,"quick_desc_size":13,"columns_mobile":"2","padding_top":36,"padding_bottom":28}},"1755084724d90f8696":{"type":"apps","disabled":true,"settings":{"include_margins":true}}},"order":["main","ebd38537-357b-4b9d-94d3-8480c1f8694b","rich_text_JGMfGU","multicolumn_ax9CUA","comparison_table_nYHpM9","multicolumn_4HGj8t","image_with_text_KnRfUR","image_with_text_j7zxWc","rich_text_XbNBGQ","image_with_text_qUeqMV","image_with_text_TGVy39","image_with_text_qNrKaF","image_with_text_XWwdrc","image_with_text_AEFWJF","image_with_text_gbR4zy","lumin_review_8EHAak","collapsible_content_3UiDhf","related-products","1755084724d90f8696"]}