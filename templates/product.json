    "custom_liquid_Ny4bQX": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% assign landing_images = product.metafields.custom.landing_page.value %}\n\n{% if landing_images != blank %}\n<div class=\"landing-images-wrapper\">\n  {% for image in landing_images %}\n    <div class=\"landing-image\">\n      <img\n        src=\"{{ image | image_url: width: 2000 }}\"\n        alt=\"{{ product.title }} - Landing Image {{ forloop.index }}\"\n        loading=\"{% if forloop.first %}eager{% else %}lazy{% endif %}\"\n        width=\"{{ image.width }}\"\n        height=\"{{ image.height }}\"\n      >\n    </div>\n  {% endfor %}\n</div>\n\n<style>\n.landing-images-wrapper{\n    width:100%;\n    margin:0;\n    padding:0;\n}\n\n.landing-image{\n    margin:0;\n    padding:0;\n    line-height:0;\n}\n\n.landing-image img{\n    display:block;\n    width:100%;\n    height:auto;\n    margin:0;\n    padding:0;\n    border:0;\n    border-radius:0;\n    box-shadow:none;\n}\n</style>\n{% endif %}",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
