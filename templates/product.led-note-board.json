slike_size":0,"feature_font_size":16}},"review_izdRUH":{"type":"review","settings":{"star_rating":5,"name_text":"Linda M.","date_text":"April 2025","review_head":"","review_text":"\"I was looking for something unique for my grandson, and this was perfect! He enjoys drawing on it every day, and it’s so easy to use.\"","like_size":42,"dislike_size":0,"feature_font_size":16}},"review_LFXpwD":{"type":"review","settings":{"star_rating":5,"name_text":"Jenna P.","date_text":"June 2025","review_head":"","review_text":"\"My kids love using this board together. It’s a wonderful way for them to bond while being creative. Highly recommend for parents looking for a fun, interactive gift.\"","like_size":66,"dislike_size":0,"feature_font_size":16}},"review_MyKUMG":{"type":"review","settings":{"star_rating":5,"name_text":"Olivia S.","date_text":"August 2025","review_head":"","review_text":"\"This LED Drawing Board is such a hit in our house! My kids love drawing their favorite designs, and the lights make it even more fun. Worth every penny!\"","like_size":66,"dislike_size":0,"feature_font_size":16}}},"block_order":["review_atbEdY","review_69rGQa","review_mmwK9n","review_Q4wjiT","review_L9RJxn","review_XpQUF7","review_izdRUH","review_LFXpwD","review_MyKUMG"],"name":"Lumin Review","settings":{"editing":true,"color_scheme":"","header_text":"what our customers say about us","show_top":true,"rating_text":"4.8","rating_range":4.5,"rating_count":"","review_column_mobile":"1","review_column_tab":"1","review_column_desk":"1","review_load":"4","load_text":"Load More","rw_img_size":140,"rw_img_radius":0,"block_name_size":20,"date_size":16,"block_head_size":20,"block_text_size":14,"star_style":"star_bg","star_size":1,"feature_svg_color":"#dff80b","inactive_star_color":"#e2e2e2","show_border":true,"rw_border":"#f2f2f2","border_radius":0,"section_bg3":"#000000","section_bg2":"#3889b9","verify_text":"Verified Buyer","review_bg":"#ffffff","feature_acc_color":"#000000","review_pd":20,"review_pd_m":20,"show_footer":true,"show_product":true,"like_text":"Was this helpful?","rw_margin":0,"padding_top":36,"padding_bottom":36}},"collapsible_content_3UiDhf":{"type":"collapsible-content","blocks":{"collapsible_row_6ANNAT":{"type":"collapsible_row","settings":{"heading":"What age group is the LED Drawing Board suitable for?","icon":"none","row_content":"<p>The LED Drawing Board is perfect for kids aged 3 and up. It's designed to be fun, easy to use, and safe for young children.<\/p>","page":""}},"collapsible_row_9HyMqd":{"type":"collapsible_row","settings":{"heading":"Is the board easy to clean?","icon":"none","row_content":"<p>Yes! The board can be easily wiped clean with a damp cloth. The markers are also washable, so you can clean off any artwork with no hassle.<\/p>","page":""}},"collapsible_row_VyDpNY":{"type":"collapsible_row","settings":{"heading":"Does the LED Drawing Board come with markers?","icon":"none","row_content":"<p>Yes, the LED Drawing Board includes a set of colorful markers to get started. You can also use any non-permanent markers for more creative options.<\/p>","page":""}},"collapsible_row_wRDgwr":{"type":"collapsible_row","settings":{"heading":"How long do the LED lights last?","icon":"none","row_content":"<p>The LED lights are energy-efficient and designed to last for many hours of use. The board is powered by a USB cable, so you don't need to worry about changing batteries.<\/p>","page":""}},"collapsible_row_U8zDz7":{"type":"collapsible_row","settings":{"heading":"Can I use the board in the dark?","icon":"none","row_content":"<p>Absolutely! The LED lights will glow brightly, even in low light or dark environments, making your drawings stand out.<\/p>","page":""}},"collapsible_row_QNi4hr":{"type":"collapsible_row","settings":{"heading":"Is the LED Drawing Board portable?","icon":"none","row_content":"<p>Yes! The LED Drawing Board is lightweight and portable, making it easy to move around the house or even take on trips.<\/p>","page":""}},"col